{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r \".tool_response.filePath // .tool_input.file_path // empty\" | { read -r f || exit 0; case \"$f\" in *.py) ruff format \"$f\" >/dev/null && ruff check --fix \"$f\" >/dev/null;; esac; } 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Formatting Python with ruff"
          }
        ]
      }
    ]
  }
}
