# Copy to .env and fill in locally. NEVER commit .env — the pre-commit hook blocks it.
# Prefer an OAuth service principal over a PAT (see SECURITY_CHECKLIST.md Pillar 5).

# --- Databricks workspace ---
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com

# Option A (preferred): OAuth service principal / machine-to-machine
DATABRICKS_CLIENT_ID=<service-principal-application-id>
DATABRICKS_CLIENT_SECRET=<from-secret-scope-never-inline>

# Option B (fallback): personal access token — short expiry, single workspace, rotate often
# DATABRICKS_TOKEN=<dapi...>

# --- SQL warehouse ---
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>

# --- Unity Catalog scoping (least privilege) ---
# Must match the bundle's dev target (databricks.yml): catalog nyc_taxi_dev, one schema per
# medallion layer. prod uses catalog nyc_taxi with the same four schemas.
DATABRICKS_CATALOG=nyc_taxi_dev
# dbt's target schema — Silver. Gold overrides it to `gold` (macros/schema_routing.sql), Bronze
# and profiling are addressed explicitly by their tasks.
DATABRICKS_SCHEMA_DEV=silver
